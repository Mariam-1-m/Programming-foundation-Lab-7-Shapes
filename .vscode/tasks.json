{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake -B build && cmake --build build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "label": "Build and Run",
            "type": "shell",
            "command": "gnome-terminal",
            "args": [
                "--",
                "bash",
                "-c",
                "${workspaceFolder}/main; echo ''; read -p 'Press Enter to close...'"
            ],
            "dependsOn": "CMake Build",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
